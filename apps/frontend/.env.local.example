NEXT_PUBLIC_SEED_ENABLED=false
# MapLibre renders the map but is not a tile provider. This OpenFreeMap style
# needs no API key and works in production; swap for MapTiler/Mapbox/Stadia
# if you need higher limits or an SLA.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
