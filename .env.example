# --- Database ---
# The backend uses SQLAlchemy async with asyncpg, so the scheme MUST be
# postgresql+asyncpg://. TLS is requested with ssl= -- the psycopg-style
# sslmode=/channel_binding= parameters make asyncpg raise TypeError.
# For local PostGIS:  postgresql+asyncpg://parallel:parallel@localhost:5433/parallel
# For Neon:            postgresql+asyncpg://<user>:<password>@<pooler-host>/neondb?ssl=require
# POSTGRES_* below feed docker-compose only and are unused when DATABASE_URL
# points at a hosted database.
POSTGRES_DB=parallel
POSTGRES_USER=parallel
POSTGRES_PASSWORD=parallel
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://parallel:parallel@localhost:5433/parallel

# --- API ---
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
SEED_ENABLED=false
SEED_ALLOW_REMOTE_DATABASE=false

# --- Neon Auth (Managed Better Auth) JWT bridge ---
# Protected FastAPI routes return 503 until all three are set. Take these from
# your Neon branch's Managed Auth settings; the issuer and audience are both the
# branch Auth URL. Neon Auth signs EdDSA (Ed25519), so leave the algorithm as-is.
# Localhost origins are pre-approved by Neon Auth, so no trusted domain is
# needed for development.
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWT_ALGORITHMS=EdDSA
AUTH_USER_ID_CLAIM=id
AUTH_ROLE_CLAIM=role

# Optional integrations; credentials stay in this backend environment only.
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
AI_API_KEY=
AI_MODEL=google/gemma-4-26b-a4b-it:free
AI_TIMEOUT_SECONDS=20
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Neon S3-compatible Object Storage; create this private bucket in the production branch.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
OBJECT_STORAGE_BUCKET=parrellel-b1
OBJECT_STORAGE_REGION=us-east-2
OBJECT_STORAGE_ADDRESSING_STYLE=path
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_URL_TTL_SECONDS=3600
UPLOAD_MAX_BYTES=10000000
